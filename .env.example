# Backend REST settings (configure secrets in Lambda, never as VITE_* variables).
DANA_BASE_URL=https://appserv.danaconnect.com
DANA_TOKEN_URL=https://auth.danaconnect.com/oauth2/token
DANA_CLIENT_ID=configure_in_lambda
DANA_CLIENT_SECRET=configure_in_lambda
DANA_OAUTH_SCOPE=conversation:access2api
DANA_OAUTH_AUTH_METHOD=basic
DANA_ONBOARDING_PROJECT_ID=204507
DANA_TOKEN_AUDIT_PROJECT_ID=207867
DANA_USERNAME=configure_in_lambda
DANA_PASSWORD=configure_in_lambda
DANA_ID_COMPANY=venturestars

# Legacy SMTP settings: retained only for old clients/local server.
DANA_ID_CONVERSATION=601944
DANA_SMTP_LOGIN=mlastra
# You can use DANA_SMTP_USER instead of DANA_SMTP_LOGIN when you already have login@idcompany.
# DANA_SMTP_USER=mlastra@venturestars
DANA_SMTP_PASS=put_password_in_local_env_only
DANA_FROM=danademo_comercial@danaconnect.com

# Optional overrides
DANA_SMTP_HOST=cloudsmtp.danaconnect.com
DANA_SMTP_PORT=587
DANA_SMTP_SECURE=false
DANA_SMTP_REQUIRE_TLS=true
DANA_SMTP_MODE=conversation
DANA_SMTP_TO=601944@venturestars.email-platform.com
DANA_CC=
DANA_BCC=
DANA_FILE_UPLOAD_URL=https://appserv.danaconnect.com/dana/conversation/http/rest/file/upload
# Optional. Defaults to DANA_USERNAME/DANA_PASSWORD, then legacy SMTP credentials.
# DANA_FILE_UPLOAD_USER=mlastra@venturestars
# DANA_FILE_UPLOAD_PASS=put_password_in_local_env_only

# Optional: override the default document-to-field map.
# Defaults:
# {"rif":"DOCUMENTO_FISCAL","documentoFiscal":"DOCUMENTO_FISCAL","registroMercantil":"DOCUMENTO_CONSTITUCION","documentoConstitucion":"DOCUMENTO_CONSTITUCION","actaDesignacionAutoridades":"FACULTADES_REPRESENTANTE","facultadesRepresentante":"FACULTADES_REPRESENTANTE","cedulaRepresentante":"DOCUMENTO_REPRESENTANTE","documentoRepresentante":"DOCUMENTO_REPRESENTANTE","documentoIdentidad":"DOCUMENTO_IDENTIDAD","licenciaConducirFrente":"LICENCIA_FRONT","licenciaConducirReverso":"LICENCIA_BACK"}

# Optional frontend override for the REST submission Lambda.
# Without this override, submission uses VITE_DOCUMENT_VALIDATION_URL (or its default URL).
# VITE_ONBOARDING_SUBMIT_URL=https://your-lambda-function-url.on.aws/

# Optional: fixed fields required by the DANAConnect conversation but not collected in the portal.
# Example:
# DANA_STATIC_DATA={"Customerid":"demo-001","EmailAddress":"demo@example.com","PrimaryPhoneNumber":"0000000000","OTPCode":"123456"}

# Optional: use if your DANAConnect conversation fields have different codes.
# Example:
# This portal already sends the DANAConnect field codes:
# EMAIL, NOMBRE_CLIENTE, NOMBRE_EMPRESA, PAIS, REPRESENTANTE_LEGAL, DOCUMENTO_FISCAL, DOCUMENTO_CONSTITUCION, FACULTADES_REPRESENTANTE, DOCUMENTO_REPRESENTANTE, DOCUMENTO_IDENTIDAD, LICENCIA_FRONT, LICENCIA_BACK, TIPO_PERSONA, NOMBRES, APELLIDOS, NUMERO_IDENTIFICACION.
# Use DANA_FIELD_MAP only if the conversation field codes change.
